# Required. Clients send this as: Authorization: Bearer <key>
MIDDLEMAN_API_KEY=change-me

# Appium 2. The container (and host venv) spawn this if nothing is listening.
APPIUM_URL=http://127.0.0.1:4723
APPIUM_BIN=
APPIUM_SPAWN=true

# Optional. Empty uses PATH (container image includes platform-tools).
# Host venv: PATH, then ~/.local/opt/platform-tools/adb
ADB_BIN=
ADB_SERIAL=

# Official Letterboxd Android app.
LETTERBOXD_PACKAGE=com.letterboxd.letterboxd
LETTERBOXD_ACTIVITY=com.letterboxd.letterboxd.MainActivity

# Docker publishes 127.0.0.1:8787 and must listen on 0.0.0.0 inside the container.
# Host venv: HOST=127.0.0.1 is fine.
HOST=0.0.0.0
PORT=8787
